# Plantilla de variables de entorno de OAK (sin valores reales ni secretos).
# Copia este archivo a .env.local en desarrollo y asigna valores sinteticos o de prueba.

# Entorno de ejecucion activo (local | preview | staging | production)
APP_ENV=

# URL publica base de la aplicacion web
NEXT_PUBLIC_APP_URL=

# PostgreSQL runtime (rol aplicativo sin privilegio BYPASSRLS) y URL CLI de migracion
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Supabase Auth y Storage (service_role confinado exclusivamente a servidor)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout y webhooks (en V1 solo claves test; sk_live_ bloqueado salvo prod + D3)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Guardias operacionales fail-closed
OAK_ENABLE_LIVE_PAYMENTS=
OAK_ALLOW_DEMO_SEED=

# Correo transaccional (Resend sandbox)
RESEND_API_KEY=
OAK_EMAIL_FROM=

# Observabilidad (Sentry sin PII)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Variables exclusivas de pruebas aisladas G3 y DAST
G3_DB_MODE=
G3_TEST_DATABASE_URL=
DAST_TARGET_URL=
PLAYWRIGHT_BASE_URL=

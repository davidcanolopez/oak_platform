{
  "name": "oak-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": "24.16.0",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "corepack pnpm exec next dev",
    "start": "corepack pnpm exec next start",
    "format:check": "node scripts/ci/run-and-capture.mjs --out reports/static/prettier.log -- corepack pnpm exec prettier --check .",
    "lint": "corepack pnpm exec eslint . --max-warnings=0 --format json --output-file reports/static/eslint.json",
    "typecheck": "node scripts/ci/run-and-capture.mjs --out reports/static/tsc.log -- corepack pnpm exec tsc --noEmit",
    "test:unit": "corepack pnpm exec vitest run --project unit --reporter=default --reporter=junit --outputFile=reports/unit/junit.xml",
    "test:coverage": "corepack pnpm exec vitest run --project unit --coverage --coverage.reportsDirectory=reports/coverage --coverage.reporter=json-summary --coverage.reporter=lcov --coverage.reporter=text",
    "build": "node scripts/ci/run-and-capture.mjs --out reports/build/next-build.log -- corepack pnpm exec next build",
    "security:sca": "corepack pnpm exec tsx scripts/security/run-sca.ts --report reports/security/sca-audit.json",
    "security:secrets": "node scripts/security/secret-scan.mjs",
    "test:integration": "node scripts/ci/fail-closed-gate.mjs --token INTEGRATION_TEST --phase P2-002/P2-010 --report reports/integration/fail-closed.json",
    "test:contract": "node scripts/ci/fail-closed-gate.mjs --token CONTRACT_TEST --phase P2-010/P3-001 --report reports/contract/fail-closed.json",
    "db:migrate:fresh": "node scripts/ci/fail-closed-gate.mjs --token DB_MIGRATE_FRESH --phase P2-002 --report reports/db/migrate-fresh.json",
    "db:migrate:previous": "node scripts/ci/fail-closed-gate.mjs --token DB_MIGRATE_FROM_PREVIOUS --phase P2-002 --report reports/db/migrate-previous.json",
    "db:seed:check": "node scripts/ci/fail-closed-gate.mjs --token SEED_IDEMPOTENCY_CHECK --phase P2-003 --report reports/db/seed-check.json",
    "test:e2e:critical": "node scripts/ci/fail-closed-gate.mjs --token E2E_CRITICAL --phase P2-008/P2-010 --report reports/e2e/critical-results.json",
    "test:e2e:full": "node scripts/ci/fail-closed-gate.mjs --token E2E_FULL --phase P4-011/P6-010 --report reports/e2e/full-results.json",
    "test:e2e:flake": "node scripts/ci/fail-closed-gate.mjs --token E2E_FLAKE_CHECK --phase P2-010/P8-001 --report reports/e2e/flake-check.json",
    "test:a11y": "node scripts/ci/fail-closed-gate.mjs --token A11Y_AUTOMATED --phase P2-007/P2-008 --report reports/a11y/axe-results.json",
    "test:a11y:manual-check": "node scripts/ci/fail-closed-gate.mjs --token A11Y_MANUAL --phase P7-001 --report reports/a11y/manual-signoff.json",
    "security:sast": "node scripts/ci/fail-closed-gate.mjs --token SAST --phase P2-005/P7-005 --report reports/security/sast-fail-closed.json",
    "security:dast": "node scripts/ci/fail-closed-gate.mjs --token DAST --phase P5-013/P7-006 --report reports/security/dast.json",
    "security:sbom": "node scripts/ci/fail-closed-gate.mjs --token SBOM --phase P7-005 --report reports/security/sbom.cdx.json",
    "test:perf": "node scripts/ci/fail-closed-gate.mjs --token PERFORMANCE --phase P7-003 --report reports/perf/perf-gate.json",
    "test:load": "node scripts/ci/fail-closed-gate.mjs --token LOAD_TEST --phase P7-003/P7-004 --report reports/perf/load-test.json",
    "deploy:preview": "node scripts/ci/fail-closed-gate.mjs --token DEPLOY_PREVIEW --phase P2-001 --report reports/ops/deploy-preview.json",
    "deploy:staging": "node scripts/ci/fail-closed-gate.mjs --token DEPLOY_STAGING --phase P5-013 --report reports/ops/deploy-staging.json",
    "test:smoke": "node scripts/ci/fail-closed-gate.mjs --token SMOKE_TEST --phase P5-013 --report reports/ops/smoke.json",
    "ops:observability-check": "node scripts/ci/fail-closed-gate.mjs --token OBSERVABILITY_CHECK --phase P2-009/P7-008 --report reports/ops/observability.json",
    "ops:backup-restore-drill": "node scripts/ci/fail-closed-gate.mjs --token BACKUP_RESTORE_DRILL --phase P7-009 --report reports/ops/backup-restore.json",
    "ops:rollback-drill": "node scripts/ci/fail-closed-gate.mjs --token ROLLBACK_DRILL --phase P7-010 --report reports/ops/rollback.json"
  },
  "dependencies": {
    "@sentry/nextjs": "11.14.0",
    "@stripe/stripe-js": "10.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.1",
    "lucide-react": "1.75.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.39.0",
    "stripe": "23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cyclonedx/cdxgen": "12.9.2",
    "@electric-sql/pglite": "0.5.16",
    "@lhci/cli": "0.16.1",
    "@microsoft/eslint-plugin-sdl": "1.1.0",
    "@playwright/test": "1.65.1",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "autocannon": "9.0.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-security": "4.2.1",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "secretlint": "14.0.1",
    "storybook": "10.6.7",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "@cyclonedx/cdxgen>body-parser": "2.4.0"
    }
  }
}
